# Always work in this folder: cd jars-flutter  (not the repo root).
#
# Copy to ".env" in this folder (gitignored) and paste real values. Keep this file as a template.
#
#   cp env.example .env
#
# The app loads env.example from assets, then merges .env from disk on iOS/Android/desktop
# (walks up from the process cwd), so you do not need to add .env to pubspec.yaml.
#
# --- Email confirmation code (OTP) ---
# In Supabase Dashboard: Authentication → Providers → Email → enable "Confirm email".
# Authentication → Email templates → "Confirm signup": include {{ .Token }} in the email body
# so users get a 6-digit code. (Magic links alone are optional; the app expects OTP entry.)

SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Web push (VAPID) — Flutter web only ---
# You do NOT need your own domain. VAPID_SUBJECT is only a contact hint (often mailto:).
#
# Generate one keypair (same run for Flutter web + Edge function):
#   cd jars-flutter && npx @pushforge/builder vapid
#
# Local build:
#   flutter build web --dart-define=WEB_PUSH_VAPID_PUBLIC_KEY=<Public Key line>
#
# Vercel: set env WEB_PUSH_VAPID_PUBLIC_KEY to that same public key (scripts/vercel-build.sh passes it).
#
# Supabase (linked project), after `npx supabase login`:
#   npx supabase secrets set \
#     VAPID_PRIVATE_KEY='{"alg":"ES256",...entire Private Key (JWK) JSON...}' \
#     VAPID_SUBJECT='mailto:you@gmail.com'
#
# Use the private JWK from the SAME generation as the public key above. If you ran `vapid` twice, pick one pair only.
